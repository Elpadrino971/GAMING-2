# Truth Battle - Environment Variables

# API Configuration
VITE_API_URL=http://localhost:3000/api

# Claude AI API (for future AI debate integration)
VITE_CLAUDE_API_KEY=your-api-key-here

# OpenAI API (alternative for AI debates)
VITE_OPENAI_API_KEY=your-api-key-here

# App Configuration
VITE_APP_NAME=Truth Battle
VITE_APP_VERSION=2.3.0
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_AI_DEBATES=false
VITE_ENABLE_MULTIPLAYER=false
VITE_ENABLE_TOURNAMENTS=false
VITE_ENABLE_PREMIUM=false

# Analytics (optional)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Social (optional)
VITE_FACEBOOK_APP_ID=
VITE_TWITTER_API_KEY=
